# Copy to .env (gitignored) in this directory; read by `make deploy`.
# Shell syntax: quote values containing spaces or '#'. Every value is optional.
# Settings: https://github.com/StunlockStudios/vrising-dedicated-server-instructions/blob/master/1.1.x-pc/INSTRUCTIONS.md

VRISING_SERVER_PASSWORD=     # the password players join with; empty lets anyone join
VRISING_DISCORD_WEBHOOK=     # alerts off without it; e.g. https://discord.com/api/webhooks/<id>/<token>
VRISING_CONNECT_HOST=        # public DDNS name shown in alerts; e.g. game.example.com
VRISING_ADMIN_STEAM_IDS=     # comma-separated SteamID64s allowed to `adminauth`; e.g. 76561198000000000

# Server settings; each one empty keeps what values.override.yaml sets.
VRISING_SERVER_NAME=         # server browser name; e.g. "My V Rising Server"
VRISING_DESCRIPTION=         # shown under the name in the server browser
VRISING_MAX_PLAYERS=         # e.g. 10
VRISING_GAME_MODE=           # PvE | PvP
VRISING_DIFFICULTY=          # Difficulty_Easy | Difficulty_Normal | Difficulty_Brutal
# Comma-separated ServerGameSettings.json keys; "__" separates a nested key.
# Keys and defaults: VRisingServer_Data/StreamingAssets/Settings/ServerGameSettings.json in the install.
VRISING_GAME_SETTINGS=       # e.g. "ClanSize=2,MaterialYieldModifier_Global=2,UnitStatModifiers_Global__MaxHealthModifier=1.5"
