# Copy to .env (gitignored) in this directory; read by `make deploy`.
# Shell syntax: quote values containing spaces or '#'.
# Server settings: https://github.com/mornedhels/enshrouded-server#environment-variables

# Role passwords: https://github.com/mornedhels/enshrouded-server/blob/main/docs/SERVER_ROLES.md
ENSHROUDED_ADMIN_PASSWORD=   # required, grants the Admins role; e.g. "s3cret-admin"
ENSHROUDED_FRIEND_PASSWORD=  # grants the Friends role; e.g. "s3cret-friend"
ENSHROUDED_DISCORD_WEBHOOK=  # alerts off without it; e.g. https://discord.com/api/webhooks/<id>/<token>
ENSHROUDED_CONNECT_HOST=     # public DDNS name shown in alerts; e.g. game.example.com

# Server settings; each one empty keeps what values.override.yaml sets.
ENSHROUDED_SERVER_NAME=      # server browser name; e.g. "My Enshrouded Server"
ENSHROUDED_SLOT_COUNT=       # 1-16; e.g. 8
ENSHROUDED_TEXT_CHAT=        # true | false
ENSHROUDED_VOICE_CHAT=       # true | false
# Default | Relaxed | Hard | Survival | Custom
# https://github.com/mornedhels/enshrouded-server/blob/main/docs/SERVER_DIFFICULTY.md
ENSHROUDED_DIFFICULTY=       # e.g. Custom
# Comma-separated gameSettings, only applied with difficulty Custom; keys and
# ranges in the SERVER_DIFFICULTY.md link above, without the SERVER_GS_ prefix.
ENSHROUDED_GAME_SETTINGS=    # e.g. "ENEMY_HEALTH_FACTOR=2,CURSE_MODIFIER=Off,WEATHER_FREQUENCY=Often"
