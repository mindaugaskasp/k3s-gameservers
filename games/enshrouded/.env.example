# Copy to .env (gitignored) in this directory; read by `make deploy`.
# Shell syntax: quote values containing spaces or '#'.
ENSHROUDED_ADMIN_PASSWORD=   # required; joining with it grants the Admins role
ENSHROUDED_FRIEND_PASSWORD=  # joining password for the Friends role
ENSHROUDED_DISCORD_WEBHOOK=  # alerts are turned off without it
ENSHROUDED_CONNECT_HOST=     # public DDNS name, shown in alerts

# Server settings; each one empty keeps what values.override.yaml sets.
ENSHROUDED_SERVER_NAME=      # name in the server browser
ENSHROUDED_SLOT_COUNT=       # 1-16
ENSHROUDED_TEXT_CHAT=        # true | false
ENSHROUDED_VOICE_CHAT=       # true | false
ENSHROUDED_DIFFICULTY=       # Default | Relaxed | Hard | Survival | Custom
# Comma-separated gameSettings, only applied with difficulty Custom, e.g.
# "ENEMY_HEALTH_FACTOR=2,CURSE_MODIFIER=Off". Keys: docs/enshrouded.md
ENSHROUDED_GAME_SETTINGS=
