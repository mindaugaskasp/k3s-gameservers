# Copy to .env (gitignored) in this directory; read by `make deploy`.
# Shell syntax: quote values containing spaces or '#'.
TERRARIA_SERVER_PASSWORD=    # the password players join with; empty lets anyone join
TERRARIA_CONNECT_HOST=       # public DDNS name shown in alerts; e.g. game.example.com
TERRARIA_DISCORD_WEBHOOK=    # alerts off without it; e.g. https://discord.com/api/webhooks/<id>/<token>
