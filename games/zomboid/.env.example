# Copy to .env (gitignored) in this directory; read by `make deploy`.
# Shell syntax: quote values containing spaces or '#'.
ZOMBOID_ADMIN_PASSWORD=    # required
ZOMBOID_RCON_PASSWORD=     # required
ZOMBOID_WORLD_NAME=        # required, the world's folder; a new name starts a NEW world
ZOMBOID_SERVER_NAME=       # server browser name; defaults to ZOMBOID_WORLD_NAME
ZOMBOID_SERVER_PASSWORD=   # join password; empty means open server
ZOMBOID_DISCORD_WEBHOOK=   # alerts are turned off without it
ZOMBOID_CONNECT_HOST=      # public DDNS name, shown in alerts
