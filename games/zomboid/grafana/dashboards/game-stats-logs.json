{
  "title": "Project Zomboid / Game Stats & Logs",
  "uid": "zomboid-game-stats-logs",
  "tags": [
    "k3s-gameservers"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Players online",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "game_server_players{game=\"projectzomboid\"}",
          "legendFormat": "players",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 2,
      "title": "Max players",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "game_server_players_max{game=\"projectzomboid\"}",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 3,
      "title": "Query latency (gamedig -> server)",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "game_server_query_duration_seconds{game=\"projectzomboid\"}",
          "legendFormat": "seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 4,
      "title": "Players online over time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "game_server_players{game=\"projectzomboid\"}",
          "legendFormat": "players",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 5,
      "title": "Currently online (session duration)",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "game_server_player_session_seconds{game=\"projectzomboid\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "game": true,
              "instance": true,
              "job": true
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "title": "Server logs (gameserver container)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 16,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"games\", pod=~\"zomboid-.*\", container=\"gameserver\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "title": "Server info",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "expr": "game_server_info{game=\"projectzomboid\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "game": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 8,
      "title": "Last started",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 8,
        "y": 26
      },
      "targets": [
        {
          "expr": "game_server_last_started_timestamp_seconds{game=\"projectzomboid\"} * 1000",
          "instant": true,
          "legendFormat": "last started",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Never"
                }
              }
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 9,
      "title": "Last updated",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 13,
        "y": 26
      },
      "targets": [
        {
          "expr": "game_server_last_updated_timestamp_seconds{game=\"projectzomboid\"} * 1000",
          "instant": true,
          "legendFormat": "last updated",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Never"
                }
              }
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 10,
      "title": "Ping",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 26
      },
      "targets": [
        {
          "expr": "game_server_ping_seconds{game=\"projectzomboid\"}",
          "legendFormat": "ping",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 11,
      "title": "Uptime -- current session (excludes restarts)",
      "type": "timeseries",
      "description": "Resets to 0 on every restart/update -- how long the currently-running process has been up.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "game_server_uptime_current_seconds{game=\"projectzomboid\"}",
          "legendFormat": "current session",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 12,
      "title": "Uptime -- lifetime total (includes restarts)",
      "type": "timeseries",
      "description": "Sum of every session's duration across all restarts/updates -- never resets, only ever grows while the server has run.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "game_server_uptime_total_seconds{game=\"projectzomboid\"}",
          "legendFormat": "lifetime total",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Players & events (from PZ's chat/user/PerkLog files)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "title": "Connections (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"fully connected\" [24h]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none"
        }
      }
    },
    {
      "id": 22,
      "title": "Deaths (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"[Died]\" [24h]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none"
        }
      }
    },
    {
      "id": 23,
      "title": "Chat messages (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"Got message:ChatMessage\" [24h]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none"
        }
      }
    },
    {
      "id": 24,
      "title": "Unique players (7d)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (player) (count_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"fully connected\" | regexp `\"(?P<player>[^\"]+)\" fully connected` [7d])))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none"
        }
      }
    },
    {
      "id": 25,
      "title": "Events per hour",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"fully connected\" [1h]))",
          "queryType": "range",
          "legendFormat": "connected",
          "step": "1h"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"disconnected player\" [1h]))",
          "queryType": "range",
          "legendFormat": "disconnected",
          "step": "1h"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"[Died]\" [1h]))",
          "queryType": "range",
          "legendFormat": "deaths",
          "step": "1h"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"Got message:ChatMessage\" [1h]))",
          "queryType": "range",
          "legendFormat": "chat messages",
          "step": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "none",
          "decimals": 0
        }
      }
    },
    {
      "id": 26,
      "title": "Longest survival (hours, 30d)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 52
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (player) (max_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"Hours Survived\" | regexp `\\[\\d{17}\\]\\[(?P<player>[^\\]]+)\\]` | regexp `Hours Survived: (?P<hours>\\d+)` | unwrap hours [30d]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "noValue": "none yet"
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "player": "Player",
              "Value": "Hours survived"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Hours survived",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 27,
      "title": "Deaths by player (30d)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 52
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (player) (count_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"[Died]\" | regexp `\\[\\d{17}\\]\\[(?P<player>[^\\]]+)\\]` [30d]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "none yet"
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "player": "Player",
              "Value": "Deaths"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Deaths",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 28,
      "title": "Connections by player (30d)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 52
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (player) (count_over_time({namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"fully connected\" | regexp `\"(?P<player>[^\"]+)\" fully connected` [30d]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "none yet"
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "player": "Player",
              "Value": "Connections"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Connections",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 29,
      "title": "Player activity (connects, logins, deaths, level-ups)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 60
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |~ `fully connected|disconnected player|\\[Died\\]|\\[Login\\]|\\[Level Changed\\]|\\[Created Player`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 30,
      "title": "Chat",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 60
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"games\", pod=~\"zomboid-.*\", container=\"game-logs\"} |= \"Got message:ChatMessage\" | regexp `chat=(?P<channel>[^,]*), author='(?P<author>[^']*)', text='(?P<text>.*)'\\}` | line_format \"[{{.channel}}] {{.author}}: {{.text}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}