{
  "title": "Minecraft / Game Stats & Logs",
  "uid": "minecraft-game-stats-logs",
  "tags": [
    "k3s-gameservers"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Players online",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "game_server_players{game=\"minecraft\"}",
          "legendFormat": "players",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 2,
      "title": "Max players",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "game_server_players_max{game=\"minecraft\"}",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 3,
      "title": "Query latency (gamedig -> server)",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "game_server_query_duration_seconds{game=\"minecraft\"}",
          "legendFormat": "seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 4,
      "title": "Players online over time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "game_server_players{game=\"minecraft\"}",
          "legendFormat": "players",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 5,
      "title": "Currently online (session duration)",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "game_server_player_session_seconds{game=\"minecraft\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "game": true,
              "instance": true,
              "job": true
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "title": "Server logs (gameserver container)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 16,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"games\", pod=~\"minecraft-.*\", container=\"gameserver\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "title": "Server info",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "expr": "game_server_info{game=\"minecraft\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "game": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 8,
      "title": "Last started",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 8,
        "y": 26
      },
      "targets": [
        {
          "expr": "game_server_last_started_timestamp_seconds{game=\"minecraft\"} * 1000",
          "instant": true,
          "legendFormat": "last started",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Never"
                }
              }
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 9,
      "title": "Last updated",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 13,
        "y": 26
      },
      "targets": [
        {
          "expr": "game_server_last_updated_timestamp_seconds{game=\"minecraft\"} * 1000",
          "instant": true,
          "legendFormat": "last updated",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Never"
                }
              }
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 10,
      "title": "Ping",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 26
      },
      "targets": [
        {
          "expr": "game_server_ping_seconds{game=\"minecraft\"}",
          "legendFormat": "ping",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 11,
      "title": "Uptime -- current session (excludes restarts)",
      "type": "timeseries",
      "description": "Resets to 0 on every restart/update -- how long the currently-running process has been up.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "game_server_uptime_current_seconds{game=\"minecraft\"}",
          "legendFormat": "current session",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 12,
      "title": "Uptime -- lifetime total (includes restarts)",
      "type": "timeseries",
      "description": "Sum of every session's duration across all restarts/updates -- never resets, only ever grows while the server has run.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "game_server_uptime_total_seconds{game=\"minecraft\"}",
          "legendFormat": "lifetime total",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 20,
      "title": "World and players",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "panels": []
    },
    {
      "id": 21,
      "title": "World settings",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "minecraft_world_setting{game=\"minecraft\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "game": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 22,
      "title": "Top players (time played)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 40
      },
      "targets": [
        {
          "expr": "game_server_player_play_time_seconds{game=\"minecraft\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "game": true,
              "instance": true,
              "job": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 23,
      "title": "Last seen",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 40
      },
      "targets": [
        {
          "expr": "game_server_player_last_seen_timestamp_seconds{game=\"minecraft\"} * 1000",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "game": true,
              "instance": true,
              "job": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        }
      }
    },
    {
      "id": 24,
      "title": "Player activity (joins, leaves)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"games\", pod=~\"minecraft-.*\", container=\"gameserver\"} |~ `joined the game|left the game|lost connection`"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
