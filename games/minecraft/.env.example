# Copy to .env (gitignored) in this directory; read by `make deploy`.
# Shell syntax: quote values containing spaces or '#'.
MINECRAFT_RCON_PASSWORD=     # required, for backups and make console; e.g. "s3cret-rcon"
MINECRAFT_OPERATORS=         # comma-separated admin player names; e.g. "Steve,Alex"
MINECRAFT_WHITELIST=         # comma-separated player names; empty lets anyone join
MINECRAFT_DISCORD_WEBHOOK=   # alerts off without it; e.g. https://discord.com/api/webhooks/<id>/<token>
MINECRAFT_CONNECT_HOST=      # public DDNS name shown in alerts; e.g. game.example.com
