{
  "title": "Valheim / Game Stats & Logs",
  "uid": "valheim-game-stats-logs",
  "tags": [
    "k3s-gameservers"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Players online",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "lgsm_game_players{game=\"valheim\"}",
          "legendFormat": "players",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 2,
      "title": "Max players",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "lgsm_game_players_max{game=\"valheim\"}",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 3,
      "title": "Query latency (gamedig -> server)",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "lgsm_game_query_duration_seconds{game=\"valheim\"}",
          "legendFormat": "seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 4,
      "title": "Players online over time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "lgsm_game_players{game=\"valheim\"}",
          "legendFormat": "players",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 5,
      "title": "Currently online (session duration)",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "lgsm_game_player_session_seconds{game=\"valheim\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "game": true,
              "instance": true,
              "job": true
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "title": "Server logs (gameserver container)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 16,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"games\", container=\"gameserver\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "title": "Server info",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "expr": "lgsm_game_info{game=\"valheim\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "game": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 8,
      "title": "Last started",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 8,
        "y": 26
      },
      "targets": [
        {
          "expr": "lgsm_game_last_started_timestamp_seconds{game=\"valheim\"} * 1000",
          "instant": true,
          "legendFormat": "last started",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Never" }
              }
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 9,
      "title": "Last updated",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 13,
        "y": 26
      },
      "targets": [
        {
          "expr": "lgsm_game_last_updated_timestamp_seconds{game=\"valheim\"} * 1000",
          "instant": true,
          "legendFormat": "last updated",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Never" }
              }
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 10,
      "title": "Ping",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 26
      },
      "targets": [
        {
          "expr": "lgsm_game_ping_seconds{game=\"valheim\"}",
          "legendFormat": "ping",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    }
  ]
}
