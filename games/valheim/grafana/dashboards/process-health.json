{
  "title": "Valheim / Process Health",
  "uid": "valheim-process-health",
  "tags": [
    "k3s-gameservers"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Server up",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "game_server_up{game=\"valheim\"}",
          "legendFormat": "up",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 2,
      "title": "PVC usage",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "Used",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        },
        {
          "expr": "kubelet_volume_stats_available_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "Free",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 18,
      "title": "PVC used %",
      "description": "local-path PVCs aren't quota-enforced, so capacity/used here reflect the host disk itself -- this is the number that says when to grow VM storage.",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * kubelet_volume_stats_used_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"} / kubelet_volume_stats_capacity_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "used %",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 3,
      "title": "Restarts (last hour)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(changes(container_start_time_seconds{namespace=\"games\", pod=~\"valheim.*\", container!=\"\"}[1h]))",
          "legendFormat": "restarts",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 4,
      "title": "Pod CPU usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"games\", pod=~\"valheim.*\", container!=\"\"}[5m])) by (container)",
          "legendFormat": "{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 5,
      "title": "Pod memory (working set)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"games\", pod=~\"valheim.*\", container!=\"\"}) by (container)",
          "legendFormat": "{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 6,
      "title": "PVC usage over time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "used bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        },
        {
          "expr": "kubelet_volume_stats_available_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "free bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 7,
      "title": "Restarts (container start-time resets)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "changes(container_start_time_seconds{namespace=\"games\", pod=~\"valheim.*\", container!=\"\"}[1h])",
          "legendFormat": "{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
