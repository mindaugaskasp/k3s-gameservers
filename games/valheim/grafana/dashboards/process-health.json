{
  "title": "Valheim / Process Health",
  "uid": "valheim-process-health",
  "tags": [
    "k3s-gameservers"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Server up",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "game_server_up{game=\"valheim\"}",
          "legendFormat": "up",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 2,
      "title": "PVC usage",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "Used",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        },
        {
          "expr": "kubelet_volume_stats_available_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "Free",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 18,
      "title": "PVC used %",
      "description": "local-path PVCs aren't quota-enforced, so capacity/used here reflect the host disk itself -- this is the number that says when to grow VM storage.",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * kubelet_volume_stats_used_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"} / kubelet_volume_stats_capacity_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "used %",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 3,
      "title": "Restarts (last hour)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(changes(container_start_time_seconds{namespace=\"games\", pod=~\"valheim.*\", container!=\"\"}[1h]))",
          "legendFormat": "restarts",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 4,
      "title": "Pod CPU usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"games\", pod=~\"valheim.*\", container!=\"\"}[5m])) by (container)",
          "legendFormat": "{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 5,
      "title": "Pod memory (working set)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"games\", pod=~\"valheim.*\", container!=\"\"}) by (container)",
          "legendFormat": "{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 6,
      "title": "PVC usage over time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "used bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        },
        {
          "expr": "kubelet_volume_stats_available_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "free bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 7,
      "title": "Restarts (container start-time resets)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "changes(container_start_time_seconds{namespace=\"games\", pod=~\"valheim.*\", container!=\"\"}[1h])",
          "legendFormat": "{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      }
    },
    {
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "Backups",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "panels": []
    },
    {
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "Backups (recent + archive)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "game_server_backup_count{game=\"valheim\"}",
          "legendFormat": "Backups on disk",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "Disk used by backups",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 21
      },
      "targets": [
        {
          "expr": "game_server_backup_bytes{game=\"valheim\"}",
          "legendFormat": "Disk used by backups",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "Newest backup age",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 21
      },
      "targets": [
        {
          "expr": "time() - game_server_backup_newest_timestamp_seconds{game=\"valheim\"}",
          "legendFormat": "Newest backup age",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 24,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "Play since last backup",
      "description": "Player activity newer than the newest backup. Should fall to 0 within ~10 min; staying red while people play means backups are not being taken.",
      "type": "stat",
      "targets": [
        {
          "expr": "clamp_min(game_server_last_player_activity_timestamp_seconds{game=\"valheim\"} - game_server_backup_newest_timestamp_seconds{game=\"valheim\"}, 0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "legendFormat": "unbacked play"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0 (no activity since pod start)"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 21
      }
    },
    {
      "id": 25,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "Cleanup index",
      "description": "backups/.play-clock. If it is missing or bad while an archive exists, pruning stops and backups pile up until it is fixed.",
      "type": "stat",
      "targets": [
        {
          "expr": "game_server_backup_play_clock_ok{game=\"valheim\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "legendFormat": "{{problem}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green"
                },
                "0": {
                  "text": "PRUNING STOPPED",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 21
      }
    },
    {
      "id": 26,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "In-game day (newest backup)",
      "description": "Valheim day of the world in the newest backup, read from the save at backup time and put in the file name.",
      "type": "stat",
      "targets": [
        {
          "expr": "max(game_server_backup_file_game_day{game=\"valheim\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "legendFormat": "day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 21
      }
    },
    {
      "id": 27,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "Archive windows filled",
      "description": "Archived backups per play-time window (days back from the newest backup; idle time doesn't count). Empty until that much play history exists.",
      "type": "bargauge",
      "targets": [
        {
          "expr": "game_server_backup_archive_window_files{game=\"valheim\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "legendFormat": "{{window}} days"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 25
      }
    },
    {
      "id": 28,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "In-game day over time",
      "description": "Advances only while people play; flat lines are idle time, when no backups are taken.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max(game_server_backup_file_game_day{game=\"valheim\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "legendFormat": "in-game day (newest backup)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 25
      }
    },
    {
      "id": 29,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "Play time recorded",
      "description": "Total play-time clock of the index (idle gaps count at most a day). Archive window ages are measured on this clock.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "game_server_backup_play_clock_seconds{game=\"valheim\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "legendFormat": "play clock"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 25
      }
    },
    {
      "id": 30,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "Archived backups",
      "description": "/config/backups/archive: the newest and oldest backup of each play-time window. 'Leaves window in' is play time until it moves on or is deleted.",
      "type": "table",
      "targets": [
        {
          "expr": "game_server_backup_file_info{game=\"valheim\",location=\"archive\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "format": "table",
          "instant": true
        },
        {
          "expr": "(game_server_backup_file_timestamp_seconds{game=\"valheim\"} and on(file) game_server_backup_file_info{game=\"valheim\",location=\"archive\"}) * 1000",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "format": "table",
          "instant": true
        },
        {
          "expr": "game_server_backup_file_game_day{game=\"valheim\"} and on(file) game_server_backup_file_info{game=\"valheim\",location=\"archive\"}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "format": "table",
          "instant": true
        },
        {
          "expr": "game_server_backup_file_play_age_seconds{game=\"valheim\"} and on(file) game_server_backup_file_info{game=\"valheim\",location=\"archive\"}",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "format": "table",
          "instant": true
        },
        {
          "expr": "game_server_backup_file_window_left_seconds{game=\"valheim\"} and on(file) game_server_backup_file_info{game=\"valheim\",location=\"archive\"}",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "format": "table",
          "instant": true
        },
        {
          "expr": "game_server_backup_file_bytes{game=\"valheim\"} and on(file) game_server_backup_file_info{game=\"valheim\",location=\"archive\"}",
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "ffyierrb4yl8gd"
          },
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "file",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "file",
                "Value #B",
                "Value #C",
                "window",
                "Value #D",
                "Value #E",
                "Value #F"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "file": "Backup file (full path)",
              "Value #B": "Taken at",
              "Value #C": "In-game day",
              "window": "Window (play-days back)",
              "Value #D": "Play-time age",
              "Value #E": "Leaves window in (play time)",
              "Value #F": "Size"
            },
            "indexByName": {
              "file": 0,
              "Value #B": 1,
              "Value #C": 2,
              "window": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Taken at",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Backup file (full path)"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 420
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Taken at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Play-time age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Leaves window in (play time)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 31
      }
    },
    {
      "id": 31,
      "datasource": {
        "type": "prometheus",
        "uid": "ffyierrb4yl8gd"
      },
      "title": "Recent backups (last 3 play-days, all kept)",
