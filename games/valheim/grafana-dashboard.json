{
  "title": "LinuxGSM / Valheim",
  "uid": "lgsm-valheim",
  "tags": ["linuxgsm", "k3s-linuxgsm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Server up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "lgsm_game_up{game=\"valheim\"}", "legendFormat": "up" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Players online",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "lgsm_game_players{game=\"valheim\"}", "legendFormat": "players" }
      ]
    },
    {
      "id": 3,
      "title": "Query latency",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "lgsm_game_query_duration_seconds{game=\"valheim\"}", "legendFormat": "seconds" }
      ]
    },
    {
      "id": 4,
      "title": "Pod CPU usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"games\", pod=~\"valheim.*\", container!=\"\"}[5m])) by (container)",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pod memory (working set)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"games\", pod=~\"valheim.*\", container!=\"\"}) by (container)",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "PVC usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"games\", persistentvolumeclaim=~\"data-valheim.*\"}",
          "legendFormat": "used bytes"
        }
      ]
    },
    {
      "id": 7,
      "title": "Restarts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total{namespace=\"games\", pod=~\"valheim.*\"}",
          "legendFormat": "{{container}}"
        }
      ]
    }
  ]
}
