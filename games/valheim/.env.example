# Copy to .env (gitignored) in this directory; read by `make deploy`.
# Shell syntax: quote values containing spaces or '#'.
VALHEIM_SERVER_PASSWORD=   # required
VALHEIM_WORLD_NAME=        # required, the save's name; a new name starts a NEW world
VALHEIM_SERVER_NAME=       # server browser name; e.g. "My Valheim Server"
VALHEIM_DISCORD_WEBHOOK=   # alerts are turned off without it
VALHEIM_CONNECT_HOST=      # public DDNS name, shown in alerts
