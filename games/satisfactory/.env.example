# Copy to .env (gitignored) in this directory; read by `make deploy`.
# Shell syntax: quote values containing spaces or '#'.
# Server settings: https://github.com/wolveix/satisfactory-server#environment-variables

SATISFACTORY_API_TOKEN=       # only with a client-protection password: server console `server.GenerateAPIToken`
SATISFACTORY_DISCORD_WEBHOOK= # alerts off without it; e.g. https://discord.com/api/webhooks/<id>/<token>
SATISFACTORY_CONNECT_HOST=    # public DDNS name shown in alerts; e.g. game.example.com

# Server settings; each one empty keeps what values.override.yaml sets.
SATISFACTORY_SERVER_NAME=     # shown in Discord alerts; the in-game name is set when the server is claimed
SATISFACTORY_SLOT_COUNT=      # max players; e.g. 4
# Comma-separated tuning, each one of the image's env vars.
SATISFACTORY_GAME_SETTINGS=   # e.g. "AUTOSAVENUM=10,MAXTICKRATE=30,DISABLESEASONALEVENTS=true"
