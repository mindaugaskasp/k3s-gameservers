# Copy to .env (gitignored) in this directory; read by `make deploy`.
# Shell syntax: quote values containing spaces or '#'.
# Settings: https://dragonwilds.runescape.wiki/w/Dedicated_Servers

DRAGONWILDS_OWNER_ID=         # required, the owner's player ID: the game's Settings screen shows it
DRAGONWILDS_WORLD_NAME=       # required, the world players search for; a new name starts a NEW world
DRAGONWILDS_ADMIN_PASSWORD=   # required, opens the in-game server management screen
DRAGONWILDS_SERVER_PASSWORD=  # the password players join with; empty lets anyone join
DRAGONWILDS_DISCORD_WEBHOOK=  # alerts off without it; e.g. https://discord.com/api/webhooks/<id>/<token>
DRAGONWILDS_CONNECT_HOST=     # public DDNS name shown in alerts; e.g. game.example.com

# Server settings; each one empty keeps what values.override.yaml sets.
DRAGONWILDS_SERVER_NAME=      # the server browser's "Created By" column; e.g. "My Dragonwilds Server"
DRAGONWILDS_ADMINS=           # comma-separated player IDs with admin rights
