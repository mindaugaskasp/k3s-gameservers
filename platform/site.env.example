# Copy to site.env (gitignored): the host's own values, read by the monitoring and firewall installs. A nip.io name needs no DNS: https://nip.io
GRAFANA_HOST=grafana.<node-ip>.nip.io
LOKI_HOST=loki.<node-ip>.nip.io
PROMETHEUS_HOST=prometheus.<node-ip>.nip.io
LAN_CIDR=192.168.1.0/24
# Discord channel webhook for platform alerts (platform/monitoring/config/alerting.yaml).
ALERTS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
