# Copy to site.env (gitignored): the host's own values, read by the monitoring and firewall installs. A nip.io name needs no DNS: https://nip.io
GRAFANA_HOST=grafana.<node-ip>.nip.io
LOKI_HOST=loki.<node-ip>.nip.io
PROMETHEUS_HOST=prometheus.<node-ip>.nip.io
N8N_HOST=n8n.<node-ip>.nip.io
LAN_CIDR=192.168.1.0/24
# Discord channel webhook for infrastructure alerts (infrastructure/monitoring/config/alerting.yaml).
ALERTS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Read by infrastructure/n8n/import-workflows.sh. The timezone sets when the workflows
# fire and how times are printed; the app password is a Google account app password
# (needs 2-step verification), not the account password.
N8N_TIMEZONE=Europe/Vilnius
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=
# OAuth client for the Google Calendar credential; the token itself is granted in the editor.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
