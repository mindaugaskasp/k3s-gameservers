# Copy to .env (gitignored).
# ssh target of the k3s host, for copy-to-vm / copy-to-host run from your own machine.
VM_HOST=user@host
# rclone remote:path for `make offsite-backup`, see docs/offsite-backups.md.
OFFSITE_BACKUP_REMOTE=gdrive:k3s-gameservers-backups
# Loki's LAN push base URL (platform/site.env LOKI_HOST); backup results go there for alerts.
LOKI_URL=http://loki.<node-ip>.nip.io
